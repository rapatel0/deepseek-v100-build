# Copy to .env and edit.

# Where the GGUF lives on the host. Must have ~90 GB free.
MODEL_DIR=/srv/models/deepseek-v4-flash

# Exact GGUF filename (verified 2026-05-04 from antirez/deepseek-v4-gguf).
GGUF_FILE=DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2.gguf

# HF repo for the GGUF.
HF_REPO=antirez/deepseek-v4-gguf

# Context window. Start small, grow once stable. Do not start at 1M.
# 86.7 GB GGUF + KV cache fits in 128 GB VRAM at 8192. Bump to 32768 once stable.
CTX_SIZE=8192

# Threads for the CPU side (host-side glue, sampler, expert offload if enabled).
# Match physical cores on the GPU host. With everything on GPU this matters less.
LLAMA_THREADS=32

# Number of GPUs visible to the container. Default to 4 V100s.
GPU_COUNT=4

# CUDA arch for the build. 70-real = V100 native binary, no JIT.
# Use "70-real;75-real;80-real" if you build one image for mixed-arch hosts.
CUDA_ARCH=70-real

# CUDA toolkit version for the build/runtime images.
# Driver 535.x supports CUDA 12.2 runtime images.
# Bump to 12.4+ only after upgrading to a 550-series driver on the host.
CUDA_VERSION=12.2.2

# Port for the OpenAI-compatible server.
PORT=8080

# K8s node name for the GPU host (4× V100 32GB recommended).
# Find it with: kubectl get nodes -o wide
NODE_NAME=gpu-01

# Image tag (local) and the registry push target the cluster pulls from.
# Microk8s often exposes its in-cluster registry on every node at :32000.
IMAGE=local/deepseek-v4-flash:cuda-sm70
REGISTRY_IMAGE=localhost:32000/deepseek-v4-flash:cuda-sm70
