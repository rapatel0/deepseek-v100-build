From: deepseek-v4-flash homelab deploy
Subject: [PATCH] ggml-cuda: tighten CONCAT supports_op to F32

The CUDA concat kernel in the antirez DSv4 fork asserts F32 for
src0/src1/dst, but supports_op was historically too permissive (only
excluded I32/I16). DSv4's graph builds non-F32 concats, so report the
truth and let the scheduler place those concats on CPU for the v2 image.
---
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5043,8 +5043,13 @@
                 return op->type == GGML_TYPE_F32 && (op->src[0]->ne[2]*op->src[0]->ne[3]) <= (1 << 15);
         case GGML_OP_CONCAT:
             {
-                ggml_type src0_type = op->src[0]->type;
-                return src0_type != GGML_TYPE_I32 && src0_type != GGML_TYPE_I16;
+                // The CUDA concat kernel asserts F32 for src0/src1/dst.
+                // supports_op was historically too permissive; DSv4 hits
+                // this path with non-F32. Report the truth so the scheduler
+                // falls back to CPU for non-F32 concats.
+                return op->type        == GGML_TYPE_F32
+                    && op->src[0]->type == GGML_TYPE_F32
+                    && op->src[1]->type == GGML_TYPE_F32;
             } break;
         case GGML_OP_CONV_TRANSPOSE_1D:
             {
