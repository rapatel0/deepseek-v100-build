@@ -85,6 +85,26 @@
 
 static_assert(sizeof(half) == sizeof(ggml_fp16_t), "wrong fp16 size");
 
+static std::atomic<uint64_t> g_cuda_graph_launches{0};
+static std::atomic<uint64_t> g_cuda_graph_eager{0};
+static std::atomic<uint64_t> g_cuda_graph_captures{0};
+static std::atomic<uint64_t> g_cuda_graph_recaptures{0};
+
+void ggml_backend_cuda_get_graph_metrics(uint64_t * launches, uint64_t * eager, uint64_t * captures, uint64_t * recaptures) {
+    if (launches) {
+        *launches = g_cuda_graph_launches.load(std::memory_order_relaxed);
+    }
+    if (eager) {
+        *eager = g_cuda_graph_eager.load(std::memory_order_relaxed);
+    }
+    if (captures) {
+        *captures = g_cuda_graph_captures.load(std::memory_order_relaxed);
+    }
+    if (recaptures) {
+        *recaptures = g_cuda_graph_recaptures.load(std::memory_order_relaxed);
+    }
+}
